# Database connection (matches docker-compose.yml)
DATABASE_URL="postgresql://daily_user:daily_pass@localhost:5433/daily_db?schema=public"

# Server configuration
PORT=3000

# Groq API (free tier — get key at https://console.groq.com)
GROQ_API_KEY="your-groq-api-key-here"

# Google Gemini API (free — get key at https://aistudio.google.com)
GEMINI_API_KEY="your-gemini-api-key-here"
